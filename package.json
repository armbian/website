{
  "name": "armbian-web-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Armbian web ecosystem: website, imager site, and shared API",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --filter='*'",
    "lint": "turbo lint --filter='*'",
    "typecheck": "turbo typecheck --filter='*'",
    "test": "turbo test --filter='*'",
    "test:e2e": "turbo test:e2e",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.9.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "@swc/core",
      "sharp"
    ]
  }
}
