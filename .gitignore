# Dependencies
node_modules/
.pnpm-store/

# Host-side cache for Docker one-shot runs (pnpm store + node_modules
# bind-mounted by manage.sh quality / manage.sh pnpm). Keeps subsequent
# runs fast without polluting the workspace tree.
cache/

# Build outputs
dist/
.next/
.turbo/
*.tsbuildinfo

# Environment — ignore all .env files except the example template
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug logs
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/

apps/www/media/

# API runtime cache
apps/api/data/.cache/

# Database backups
backups/
