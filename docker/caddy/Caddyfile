{
	email {$CADDY_EMAIL:admin@localhost}
	# Admin API for runtime config reloads from the API container.
	# Bound to the Docker network, never published to the host.
	admin 0.0.0.0:2019 {
		origins caddy:2019 localhost 127.0.0.1
	}
}

# Canonical host redirect: www.* → apex.
# Set WWW_REDIRECT_HOSTS in .env to the comma-separated list of www
# hostnames that must be 301'd to their apex (e.g.
# "www.armbian.com, www.armbian.cn, www.armbian.de"). Required so that
# locale-forced domains (armbian.cn → zh, armbian.de → de) resolve
# correctly when users type the www variant.
# Leave unset / empty in dev — the placeholder ":0" binds to an ephemeral
# port with no listener, effectively disabling the block.
{$WWW_REDIRECT_HOSTS::0} {
	redir https://{labels.1}.{labels.0}{uri} 301
}

# Website — defaults to HTTP on :80 for local dev (any host).
# Override WWW_HOSTNAME in .env with a real domain for automatic HTTPS.
{$WWW_HOSTNAME::80} {
	encode zstd gzip

	# Legacy board redirects — snippet regenerated by the API each sync.
	# Glob pattern tolerates a missing file on first boot.
	import /etc/caddy/snippets/*.caddy

	# Legacy /wp-content served on all domains.
	handle_path /wp-content/* {
		root * /srv/wp-content
		file_server
	}

	reverse_proxy www:3000

	log {
		output stdout
		format console
	}
}

# API — defaults to HTTP on :8080 for local dev.
# Override API_HOSTNAME in .env with a real domain for automatic HTTPS.
{$API_HOSTNAME::8080} {
	encode zstd gzip

	reverse_proxy api:3001 {
		# Overwrite XFF with the real peer so request.ip cannot be spoofed (e.g. /sync).
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output stdout
		format console
	}
}

# Imager hostname — proxies to www; non-root paths 301 to apex.
# Dev fallback `:8081` is listened on internally but not exposed to the
# host (no port mapping in docker-compose), so it's effectively dormant.
{$IMAGER_HOSTNAME::8081} {
	encode zstd gzip

	# 301 only human-facing routes to apex; assets, API endpoints and
	# anything with a file extension must keep loading on this hostname.
	# Redirect target is the apex (no www) — www.* is itself in
	# WWW_REDIRECT_HOSTS, so going via www would chain two 301s.
	@redirectable {
		not path / /_next/* /api/* /imager/*
		not path_regexp staticAsset \.[A-Za-z0-9]+$
	}
	redir @redirectable https://armbian.com{uri} 301

	reverse_proxy www:3000 {
		header_up Host imager.armbian.com
	}

	log {
		output stdout
		format console
	}
}
