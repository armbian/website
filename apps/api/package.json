    "@fastify/swagger-ui": "^5.0.0",
    "fastify": "^5.8.5",
    "minisearch": "^7.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
